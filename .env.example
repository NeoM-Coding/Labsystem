# Lab System Cloud local deployment configuration.
# Copy this file to .env before deployment and change all passwords outside local development.

TZ=Asia/Shanghai
DEPLOY_WAIT_TIMEOUT=180
LOG_PATH=./logs

# Container images
MYSQL_IMAGE=mysql:8.0.44
POSTGRES_IMAGE=postgres:17.10-alpine3.23
REDIS_IMAGE=redis:8.8.0-alpine
EMQX_IMAGE=emqx/emqx:5.8.5
PERMIFY_IMAGE=ghcr.io/permify/permify:v1.6.7
NACOS_IMAGE=nacos/nacos-server:v3.2.3
LOKI_IMAGE=grafana/loki:3.7.3
ALLOY_IMAGE=grafana/alloy:v1.16.1
GRAFANA_IMAGE=grafana/grafana:13.1.0
JAVA_RUNTIME_IMAGE=eclipse-temurin:17-jre-jammy

# Java containers mount module target directories and restart the child JVM when a JAR changes.
JAVA_TOOL_OPTIONS='-XX:MaxRAMPercentage=75.0 -Dfile.encoding=UTF-8'
HOT_RELOAD_INTERVAL_SECONDS=2
HOT_RELOAD_SETTLE_SECONDS=2
HOT_RELOAD_SOURCE_INTERVAL_SECONDS=2
APP_RESTART_DELAY_SECONDS=3

# MySQL and application datasource
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=lab_sys
UID_DATABASE=fun_cloud_base
MYSQL_USERNAME=root
MYSQL_PASSWORD='lab-system-local'
AES_KEY='0123456789abcdef'
LAB_DB_URL='jdbc:mysql://localhost:3306/lab_sys?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai'
UID_DB_URL='jdbc:mysql://localhost:3306/fun_cloud_base?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai'

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_USERNAME=
REDIS_PASSWORD=

# EMQX / MQTT
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_WS_PORT=8083
MQTT_WSS_PORT=8084
MQTT_TLS_PORT=8883
# MQTT_USERNAME=
# MQTT_PASSWORD=
EMQX_DASHBOARD_PORT=18083
EMQX_DASHBOARD_USERNAME=admin
EMQX_DASHBOARD_PASSWORD='public123'

# Permify bootstrap
PERMIFY_HOST=localhost
PERMIFY_HTTP_PORT=3476
PERMIFY_GRPC_PORT=3478
PERMIFY_TENANT_ID=t1
PERMIFY_APP_ID=global
PERMIFY_SCHEMA_FILE=domains/auth/service/schema/lab-system-v2.perm

# Dedicated PostgreSQL for Permify. Keep password URL-safe because it is used in a connection URI.
PERMIFY_POSTGRES_PORT=5433
PERMIFY_POSTGRES_DATABASE=permify
PERMIFY_POSTGRES_USERNAME=permify
PERMIFY_POSTGRES_PASSWORD='permify-local'

# Initial system super administrator. BCrypt is precompiled and verified by a Java test.
SUPER_ADMIN_USER_ID=1
SUPER_ADMIN_NAME=系统超级管理员
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD='Admin@123456'
SUPER_ADMIN_PASSWORD_BCRYPT='$2a$10$7FMYYcCMn2PAIUSN5BjEuOOOQzJCP4MTsBzVSTjeiNBOwGZkqdSHS'
SUPER_ADMIN_EMAIL=admin@lab.local
SUPER_ADMIN_MARK=系统初始化超级管理员

# Nacos
NACOS_HOST=localhost
NACOS_PORT=8848
NACOS_GRPC_PORT=9848
NACOS_CONSOLE_PORT=8080
NACOS_AUTH_ENABLE=false
NACOS_AUTH_TOKEN='bGFiLXN5c3RlbS1jbG91ZC1sb2NhbC1uYWNvcy10b2tlbi0yMDI2'
NACOS_AUTH_IDENTITY_KEY=lab-system
NACOS_AUTH_IDENTITY_VALUE='lab-system-local'
NACOS_USERNAME=
NACOS_PASSWORD=
NACOS_NAMESPACE=public
NACOS_REGISTRY_GROUP=LAB_SYSTEM
NACOS_CONFIG_GROUP=LAB_SYSTEM

# Application and Dubbo ports. Provider RPC ports must be unique on one host.
WEB_SERVER_PORT=8989
BASE_SERVER_PORT=3332
MQTT_SERVER_PORT=3333
RULE_ENGINE_SERVER_PORT=3334
EDU_SERVER_PORT=3335
BASE_DUBBO_PORT=50051
MQTT_DUBBO_PORT=50052
RULE_ENGINE_DUBBO_PORT=50053
EDU_DUBBO_PORT=50054
DUBBO_QOS_ENABLE=false
BASE_DUBBO_QOS_PORT=22221
MQTT_DUBBO_QOS_PORT=22222
RULE_ENGINE_DUBBO_QOS_PORT=22223
WEB_DUBBO_QOS_PORT=22224
EDU_DUBBO_QOS_PORT=22225
DUBBO_PROVIDER_TIMEOUT=5000
DUBBO_CONSUMER_TIMEOUT=5000
# WARN 保留 RPC 警告和异常；本地排查注册、连接问题时可临时改为 INFO 或 DEBUG。
DUBBO_LOG_LEVEL=WARN

# MQTT 遥测与 WebSocket 实时推送
MQTT_REALTIME_COALESCE_WINDOW_MILLIS=200
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:8989,http://127.0.0.1:8989
WEBSOCKET_SEND_TIME_LIMIT_MILLIS=10000
WEBSOCKET_SEND_BUFFER_BYTES=1048576
WEBSOCKET_PING_INTERVAL_MILLIS=25000
WEBSOCKET_IDLE_TIMEOUT_MILLIS=60000

# Shared authorization and tracing behavior
PERMIFY_SCHEMA_VERSION=
PERMIFY_DEPTH=20
PERMIFY_LOOKUP_PAGE_SIZE=100
TRACING_ENABLED=true
TRACING_MAX_ARGUMENT_LENGTH=2048
TRACING_MAX_COLLECTION_SIZE=20
TRACING_MAX_DEPTH=3

# Rule engine runtime switches
RULE_ENGINE_PERSISTENCE_ENABLED=true
RULE_ENGINE_SIMPLE_TEST_ENABLED=false

# Edu Excel import
EDU_IMPORT_MAX_BYTES=5242880

# Logging platform
LOKI_PORT=3100
ALLOY_PORT=12345
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD='admin'
