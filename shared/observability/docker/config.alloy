loki.source.file "lab_system" {
  targets = [
    {
      __path__ = "/var/log/lab-system/*.log",
      job      = "lab-system-cloud",
    },
  ]
  file_match {
    enabled     = true
    sync_period = "5s"
  }
  forward_to = [loki.process.lab_system.receiver]
}

loki.process "lab_system" {
  stage.regex {
    source     = "filename"
    expression = ".*/(?P<service>[^/]+)\\.log$"
  }
  stage.labels {
    values = {
      service = "",
    }
  }
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

otelcol.receiver.otlp "lab_system" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  http {
    endpoint = "0.0.0.0:4318"
  }
  output {
    traces = [otelcol.processor.batch.lab_system.input]
  }
}

otelcol.processor.batch "lab_system" {
  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}
